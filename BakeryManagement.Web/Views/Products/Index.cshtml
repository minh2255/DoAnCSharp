@model ProductListVm
@{ ViewData["Title"] = "Sản phẩm"; }

<div class="row">
  <!-- Cột trái: danh mục -->
  <div class="col-md-3 mb-3">
    <div class="list-group">
      <a class="list-group-item @(Model.CategoryId == null ? "active" : "")"
         asp-action="Index" asp-route-q="@Model.Keyword">Tất cả</a>
      @foreach (var c in Model.Categories)
      {
          <a class="list-group-item @(Model.CategoryId == c.CategoryId ? "active" : "")"
             asp-action="Index" asp-route-cat="@c.CategoryId" asp-route-q="@Model.Keyword">@c.Name</a>
      }
    </div>
  </div>

  <!-- Cột phải: tìm kiếm + lưới sản phẩm -->
  <div class="col-md-9">
    <form method="get" class="input-group mb-3">
      <input type="hidden" name="cat" value="@Model.CategoryId" />
      <input class="form-control" name="q" value="@Model.Keyword" placeholder="Tìm theo tên hoặc mô tả..." />
      <button class="btn btn-brand">Tìm kiếm</button>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">Không tìm thấy sản phẩm phù hợp.</div>
    }

    <div class="row row-cols-2 row-cols-lg-3 g-3">
      @foreach (var p in Model.Items)
      {
          <div class="col"><partial name="_ProductCard" model="p" /></div>
      }
    </div>

    <nav class="mt-4">
      <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
              <a class="page-link" asp-action="Index" asp-route-q="@Model.Keyword"
                 asp-route-cat="@Model.CategoryId" asp-route-page="@i">@i</a>
            </li>
        }
      </ul>
    </nav>
  </div>
</div>