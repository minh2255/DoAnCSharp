@model Product
@{
    ViewData["Title"] = Model.Name;
    var v = ProductVisual.For(Model.Category?.Name);
    var low = Model.Stock > 0 && Model.Stock <= 5;
}

<nav class="crumbs" aria-label="breadcrumb">
  <a asp-controller="Home" asp-action="Index">Trang chủ</a><span>/</span>
  <a asp-action="Index">Sản phẩm</a><span>/</span>
  <b>@Model.Name</b>
</nav>

<div class="row g-4 g-lg-5">
  <div class="col-md-6">
    <div class="detail-media @v.Tone">
      @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Name" /> }
      else { <span>@v.Emoji</span> }
    </div>
  </div>

  <div class="col-md-6">
    <span class="pcard-cat">@Model.Category?.Name</span>
    <h1 class="detail-title">@Model.Name</h1>
    <div class="detail-price">@Model.Price.ToString("N0") ₫</div>

    @if (Model.Stock <= 0)
    {
      <span class="stock stock-out">● Hết hàng</span>
    }
    else if (low)
    {
      <span class="stock stock-low">● Sắp hết, chỉ còn @Model.Stock sản phẩm</span>
    }
    else
    {
      <span class="stock stock-ok">● Còn hàng (@Model.Stock sản phẩm)</span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
      <p class="detail-desc">@Model.Description</p>
    }

    @if (Model.Stock > 0)
    {
      <form asp-controller="Cart" asp-action="Add" method="post" class="buy-box">
        <input type="hidden" name="id" value="@Model.ProductId" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

        <label class="form-label fw-semibold" for="qty">Số lượng</label>
        <div class="qty">
          <button type="button" id="qty-minus" aria-label="Giảm">−</button>
          <input type="number" name="qty" id="qty" value="1" min="1" max="@Model.Stock" />
          <button type="button" id="qty-plus" aria-label="Tăng">+</button>
        </div>

        <div class="d-flex gap-2 flex-wrap mt-3">
          <button type="submit" name="buyNow" value="false" class="btn btn-ghost btn-lg">🛒 Thêm vào giỏ</button>
          <button type="submit" name="buyNow" value="true" class="btn btn-brand btn-lg">Mua ngay</button>
        </div>
      </form>
    }

    <ul class="perks">
      <li>🔥 Nướng mới trong ngày</li>
      <li>🚚 Giao tận nơi</li>
      <li>💵 Thanh toán khi nhận hàng</li>
    </ul>
  </div>
</div>

@section Scripts {
<script>
  (function () {
    var q = document.getElementById('qty');
    if (!q) return;
    var max = parseInt(q.max, 10) || 1;
    function clamp() {
      var v = parseInt(q.value, 10);
      if (isNaN(v) || v < 1) v = 1;
      if (v > max) v = max;
      q.value = v;
    }
    document.getElementById('qty-minus').onclick = function () { q.value = (parseInt(q.value, 10) || 1) - 1; clamp(); };
    document.getElementById('qty-plus').onclick  = function () { q.value = (parseInt(q.value, 10) || 0) + 1; clamp(); };
    q.addEventListener('change', clamp);
  })();
</script>
}
