@model Product
@{ ViewData["Title"] = Model.Name; }
<div class="row g-4">
  <div class="col-md-5"><div class="product-img" style="height:320px;border-radius:1rem">
    @if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Name" /> } else { <span style="font-size:8rem">🍰</span> }
  </div></div>
  <div class="col-md-7">
    <small class="text-muted">@Model.Category?.Name</small>
    <h2>@Model.Name</h2>
    <div class="price fs-3 mb-3">@Model.Price.ToString("N0") ₫</div>
    <p>@Model.Description</p>
    <p>Tình trạng: @(Model.Stock > 0 ? $"Còn {Model.Stock} sản phẩm" : "Hết hàng")</p>

    @if (Model.Stock > 0)
    {
      <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.ProductId" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

        <label class="form-label fw-semibold">Số lượng</label>
        <div class="input-group mb-3" style="max-width:160px">
          <button type="button" class="btn btn-outline-secondary" id="qty-minus">−</button>
          <input type="number" name="qty" id="qty" value="1" min="1" max="@Model.Stock"
                 class="form-control text-center" />
          <button type="button" class="btn btn-outline-secondary" id="qty-plus">+</button>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <button type="submit" name="buyNow" value="false" class="btn btn-outline-secondary">
            🛒 Thêm vào giỏ
          </button>
          <button type="submit" name="buyNow" value="true" class="btn btn-brand">
            Mua ngay
          </button>
        </div>
      </form>
    }
    <a class="btn btn-link mt-3" asp-action="Index">← Quay lại danh sách</a>
  </div>
</div>

@section Scripts {
<script>
  (function () {
    var q = document.getElementById('qty');
    if (!q) return;
    var max = parseInt(q.max, 10) || 1;
    function clamp() {
      var v = parseInt(q.value, 10);
      if (isNaN(v) || v < 1) v = 1;
      if (v > max) v = max;
      q.value = v;
    }
    document.getElementById('qty-minus').onclick = function () { q.value = (parseInt(q.value, 10) || 1) - 1; clamp(); };
    document.getElementById('qty-plus').onclick  = function () { q.value = (parseInt(q.value, 10) || 0) + 1; clamp(); };
    q.addEventListener('change', clamp);
  })();
</script>
}