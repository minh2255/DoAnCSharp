@model Product

<div class="card product-card h-100">
  <div class="product-img">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.Name" />
    }
    else
    {
        <span>🍰</span>
    }
  </div>
  <div class="card-body d-flex flex-column">
    <small class="text-muted">@Model.Category?.Name</small>
    <h6 class="card-title">
      <a class="text-decoration-none text-dark" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">@Model.Name</a>
    </h6>
    <div class="price mb-2">@Model.Price.ToString("N0") ₫</div>
        
    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
        <input type="hidden" name="id" value="@Model.ProductId" />
        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        @if (Model.Stock > 0)
        {
            <button class="btn btn-brand btn-sm w-100">Thêm vào giỏ</button>
        }
        else
        {
            <button class="btn btn-secondary btn-sm w-100" disabled>Hết hàng</button>
        }
    </form>
  </div>
</div>