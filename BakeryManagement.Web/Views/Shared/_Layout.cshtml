@{
    var cs = Context.Session.GetString("cart");
    var cartCount = cs == null ? 0
        : System.Text.Json.JsonSerializer.Deserialize<List<CartItem>>(cs).Sum(x => x.Qty);
    var ctl = (string)ViewContext.RouteData.Values["controller"];
    string Act(string c) => ctl == c ? "active" : "";
    var uname = User.Identity?.Name ?? "";
    var initial = uname.Trim().Length > 0 ? uname.Trim().Split(' ').Last()[0].ToString().ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Ngọt Ngào Bakery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<div class="topbar">🚚 Giao tận nơi &nbsp;·&nbsp; Thanh toán khi nhận hàng &nbsp;·&nbsp; Bánh nướng mới mỗi ngày</div>

<nav class="navbar navbar-expand-lg site-nav sticky-top">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
      <span class="brand-mark">🥐</span>
      <span class="brand-text">Ngọt Ngào<small>BAKERY</small></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Mở menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link @Act("Home")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="nav-item"><a class="nav-link @Act("Products")" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
        <li class="nav-item"><a class="nav-link @Act("Orders")" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
      </ul>

      <form class="nav-search" asp-controller="Products" asp-action="Index" method="get" role="search">
        <input class="form-control" name="q" placeholder="Tìm bánh..." aria-label="Tìm bánh" />
        <button class="btn" aria-label="Tìm">🔍</button>
      </form>

      <div class="nav-actions">
        <a class="cart-link" asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng">
          🛒<span class="cart-badge">@cartCount</span>
        </a>

        @if (User.Identity.IsAuthenticated)
        {
          <div class="dropdown">
            <button class="user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="avatar">@initial</span>
              <span class="user-name d-none d-xl-inline">@uname</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Hồ sơ của tôi</a></li>
              <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
              <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                  <button class="dropdown-item text-danger">Đăng xuất</button>
                </form>
              </li>
            </ul>
          </div>
        }
        else
        {
          <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Đăng nhập</a>
          <a class="btn btn-brand" asp-controller="Account" asp-action="Register">Đăng ký</a>
        }
      </div>
    </div>
  </div>
</nav>

<main class="container page">
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-warning alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button></div> }
    @RenderBody()
</main>

<footer class="site-footer">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-5">
        <div class="foot-brand">🥐 Ngọt Ngào Bakery</div>
        <p class="mb-0">Bánh tươi nướng mỗi ngày, đặt trực tuyến và nhận tại nhà.</p>
      </div>
      <div class="col-6 col-md-3">
        <h6>Khám phá</h6>
        <ul class="list-unstyled mb-0">
          <li><a asp-controller="Products" asp-action="Index">Tất cả sản phẩm</a></li>
          <li><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
          <li><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-4">
        <h6>Tài khoản</h6>
        <ul class="list-unstyled mb-0">
          <li><a asp-controller="Account" asp-action="Profile">Hồ sơ của tôi</a></li>
          <li><a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></li>
          <li><a asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-copy">© 2026 Ngọt Ngào Bakery – Đồ án môn Ngôn ngữ lập trình C#</div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
