@{
    var cs = Context.Session.GetString("cart");
    var cartCount = cs == null ? 0
        : System.Text.Json.JsonSerializer.Deserialize<List<CartItem>>(cs).Sum(x => x.Qty);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Ngọt Ngào Bakery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
  <div class="container">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">🥐 Ngọt Ngào Bakery</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
      </ul>
      <form class="d-flex" asp-controller="Products" asp-action="Index" method="get">
        <input class="form-control me-2" name="q" placeholder="Tìm bánh..." />
        <button class="btn btn-brand">Tìm</button>
      </form>
      <a class="btn btn-outline-secondary ms-3 me-2" asp-controller="Cart" asp-action="Index">
          🛒 Giỏ hàng <span class="badge bg-danger">@cartCount</span>
      </a>
      @if (User.Identity.IsAuthenticated)
      {
          <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
              <span class="me-2">Xin chào, <b>@User.Identity.Name</b></span>
              <button class="btn btn-sm btn-outline-danger">Đăng xuất</button>
          </form>
      }
      else
      {
          <a class="btn btn-sm btn-outline-dark me-1" asp-controller="Account" asp-action="Login">Đăng nhập</a>
          <a class="btn btn-sm btn-brand" asp-controller="Account" asp-action="Register">Đăng ký</a>
      }
    </div>
  </div>
</nav>

<main class="container py-4">
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }
    @RenderBody()
</main>

<footer class="text-center text-muted py-4 border-top">
    © 2026 Ngọt Ngào Bakery – Đồ án môn Ngôn ngữ lập trình C#
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>