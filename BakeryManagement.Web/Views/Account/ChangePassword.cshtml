@model ChangePasswordVm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="row justify-content-center"><div class="col-md-5">
  <h3>Đổi mật khẩu</h3>
  <form asp-action="ChangePassword" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Mật khẩu mới</label><input asp-for="NewPassword" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" class="form-control" /></div>
    <button class="btn btn-brand w-100">Đổi mật khẩu</button>
    <a asp-action="Profile" class="btn btn-link w-100 mt-2">← Quay lại hồ sơ</a>
  </form>
</div></div>