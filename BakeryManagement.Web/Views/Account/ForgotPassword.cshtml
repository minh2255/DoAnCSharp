@model ForgotPasswordVm
@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="row justify-content-center"><div class="col-md-5">
  <h3>Quên mật khẩu</h3>
  @if (ViewBag.Sent == true)
  {
    <div class="alert alert-info">
      Nếu email này đã đăng ký, hệ thống sẽ gửi liên kết đặt lại mật khẩu (có hiệu lực 15 phút).
    </div>
    @if (ViewBag.DevLink != null)
    {
      <div class="alert alert-warning">
        <b>Chế độ phát triển</b> (chưa cấu hình gửi email), dùng liên kết này:<br />
        <a href="@ViewBag.DevLink">@ViewBag.DevLink</a>
      </div>
    }
  }
  <form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Email đã đăng ký</label><input asp-for="Email" class="form-control" /></div>
    <button class="btn btn-brand w-100">Gửi liên kết đặt lại</button>
    <a asp-action="Login" class="btn btn-link w-100 mt-2">← Quay lại đăng nhập</a>
  </form>
</div></div>