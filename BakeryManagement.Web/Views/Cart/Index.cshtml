@model List<CartLine>
@{ ViewData["Title"] = "Giỏ hàng"; }

<h3>Giỏ hàng</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">Giỏ hàng trống. <a asp-controller="Products" asp-action="Index">Mua sắm ngay</a></div>
}
else
{
    <div class="table-responsive">
      <table class="table align-middle bg-white">
        <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th style="width:170px">Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
          <tr>
            <td>@l.Product.Name</td>
            <td>@l.Product.Price.ToString("N0") ₫</td>
            <td>
              <form asp-action="Update" method="post" class="d-flex gap-1">
                <input type="hidden" name="id" value="@l.Product.ProductId" />
                <input type="number" name="qty" value="@l.Qty" min="0" max="@l.Product.Stock" class="form-control form-control-sm" />
                <button class="btn btn-sm btn-outline-secondary">Cập nhật</button>
              </form>
            </td>
            <td>@l.Total.ToString("N0") ₫</td>
            <td>
              <form asp-action="Remove" method="post">
                <input type="hidden" name="id" value="@l.Product.ProductId" />
                <button class="btn btn-sm btn-outline-danger">Xóa</button>
              </form>
            </td>
          </tr>
        }
        </tbody>
        <tfoot>
          <tr><th colspan="3" class="text-end">Tổng cộng</th>
              <th colspan="2" class="price fs-5">@Model.Sum(x => x.Total).ToString("N0") ₫</th></tr>
        </tfoot>
      </table>
    </div>

    <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">Tiếp tục mua</a>
    <a class="btn btn-brand" asp-action="Checkout">Thanh toán</a>
}