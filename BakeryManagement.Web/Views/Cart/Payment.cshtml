@model CheckoutVm
@{
    Layout = null;   // trang riêng, trông như một cổng thanh toán bên ngoài
    var total = Model.Lines.Sum(l => l.Total);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cổng thanh toán (mô phỏng)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #eef2f7; }
        .pay-card { max-width: 520px; margin: 40px auto; border: 0; border-radius: 14px; box-shadow: 0 10px 30px rgba(20, 40, 80, .12); }
        .pay-head { background: #0b5ed7; color: #fff; border-radius: 14px 14px 0 0; padding: 18px 22px; }
        .amount { font-size: 2rem; font-weight: 700; color: #0b5ed7; }
        .method { border: 1.5px solid #dee2e6; border-radius: 10px; padding: 10px 14px; cursor: pointer; }
        .method:has(input:checked) { border-color: #0b5ed7; background: #f0f6ff; }
    </style>
</head>
<body>
<div class="card pay-card">
    <div class="pay-head">
        <div class="fw-bold fs-5">Cổng thanh toán</div>
        <small>Môi trường mô phỏng – không kết nối ngân hàng, không trừ tiền thật</small>
    </div>
    <div class="card-body p-4">
        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Đơn vị nhận tiền</span><b>Ngọt Ngào Bakery</b></div>
        <div class="d-flex justify-content-between mb-1"><span class="text-muted">Số món</span><span>@Model.Lines.Sum(l => l.Qty) sản phẩm</span></div>
        <div class="d-flex justify-content-between mb-3"><span class="text-muted">Giao đến</span><span class="text-end">@Model.Address</span></div>
        <div class="text-center mb-4">
            <div class="text-muted">Số tiền</div>
            <div class="amount">@total.ToString("N0") ₫</div>
        </div>

        <form method="post">
            <div class="mb-3">
                <div class="mb-2 fw-semibold">Chọn phương thức</div>
                <label class="method d-flex align-items-center gap-2 mb-2">
                    <input type="radio" name="kenh" value="vi" class="form-check-input mt-0" checked /> Ví điện tử
                </label>
                <label class="method d-flex align-items-center gap-2 mb-2">
                    <input type="radio" name="kenh" value="atm" class="form-check-input mt-0" /> Thẻ ATM nội địa
                </label>
                <label class="method d-flex align-items-center gap-2">
                    <input type="radio" name="kenh" value="visa" class="form-check-input mt-0" /> Thẻ quốc tế (Visa, Mastercard)
                </label>
            </div>
            <div class="d-grid gap-2">
                <button class="btn btn-primary btn-lg" asp-action="ConfirmPayment">Thanh toán @total.ToString("N0") ₫</button>
                <button class="btn btn-outline-secondary" asp-action="CancelPayment">Hủy thanh toán, quay lại cửa hàng</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
