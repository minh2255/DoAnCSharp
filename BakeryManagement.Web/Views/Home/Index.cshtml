@model List<Product>
@{
    ViewData["Title"] = "Trang chủ";
    var cats = (List<Category>)ViewBag.Categories;
}

<div class="hero mb-4">
  <h1 class="fw-bold">Bánh tươi nướng mỗi ngày 🥖</h1>
  <p class="lead">Đặt bánh trực tuyến – giao tận nơi, đảm bảo nóng giòn và tươi ngon.</p>
  <a class="btn btn-brand btn-lg" asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>
</div>

<h4 class="mb-3">Danh mục</h4>
<div class="mb-4">
  @foreach (var c in cats)
  {
      <a class="btn btn-outline-secondary me-2 mb-2" asp-controller="Products" asp-action="Index" asp-route-cat="@c.CategoryId">@c.Name</a>
  }
</div>

<h4 class="mb-3">Sản phẩm mới</h4>
<div class="row row-cols-2 row-cols-md-4 g-3">
  @foreach (var p in Model)
  {
      <div class="col"><partial name="_ProductCard" model="p" /></div>
  }
</div>